<!DOCTYPE html>
<html lang="ur">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hira - AI Friend</title>
<style>
body{background:#020a1a;color:white;font-family:Arial;margin:0;display:flex;flex-direction:column;height:100vh}
header{background:#061a3a;padding:12px;text-align:center;border-bottom:2px solid #00bfff;box-shadow:0 0 20px #00bfff}
header img{width:70px;height:70px;border-radius:50%;border:2px solid #00bfff;object-fit:cover}
header h2{margin:5px 0 0;color:#00e5ff}
header p{margin:0;font-size:12px;color:#9beaff}
#chat{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px}
.msg{max-width:80%;padding:10px 12px;border-radius:15px;line-height:1.4}
.user{align-self:flex-end;background:#00bfff;color:#021}
.hira{align-self:flex-start;background:#0a254d;border:1px solid #00bfff}
#box{display:flex;padding:10px;background:#061a3a;gap:8px}
input{flex:1;padding:12px;border-radius:20px;border:1px solid #00bfff;background:#02102a;color:white;outline:none}
button{padding:12px 18px;border-radius:20px;border:none;background:#00bfff;font-weight:bold}
</style>
</head>
<body>
<header>
<img src="hira.png" onerror="this.src='https://i.imgur.com/8Km9tLL.png'">
<h2>HIRA 💙</h2>
<p>Online • Tumhari AI Friend • Neon Blue</p>
</header>
<div id="chat"></div>
<div id="box">
<input id="inp" placeholder="Kuch likho...">
<button onclick="send()">Send</button>
</div>
<script>
let chat=document.getElementById('chat');
let count=0;
let userName="";
let waitingForName=true;
function add(text,who){let d=document.createElement('div');d.className='msg '+who;d.innerText=text;chat.appendChild(d);chat.scrollTop=chat.scrollHeight;}
function hiraReply(userText){
let t=userText.toLowerCase(); count++;
let n = userName ? userName : "dost";
if(t.includes("salam")||t.includes("assalam")) return "Walaikum Salam "+n+"! 💙 Kese ho?";
if(t.includes("student")) return "Oh acha! Tum student ho? Kis class me ho "+n+"? Aur parhai kesi chal rahi hai? 😊";
if(t.includes("help")||t.includes("madad")) return "Haan "+n+", bolo kis cheez me help chahiye? Parhai me? Ya koi aur kaam hai? Main hun na yahan! 💙";
if(t.includes("kese ho")||t.includes("kaisa")||t.includes("kaisi")) return "Main theek hun "+n+", tum sunao!";
if(t.includes("naam")) return "Tumhara naam "+n+" hai na, mujhe yaad hai! Aur mera naam Hira hai.";
if(t.includes("love")||t.includes("pyaar")||t.includes("pasand")) return "Aww "+n+", tum boht cute ho 😊";
if(t.includes("bore")||t.includes("bor")) return "Bore ho? Chalo mujh se koi funny baat pucho, ya apne bare me batao!";
if(t.includes("has")||t.includes("haha")||t.includes("😂")||t.includes("🤣")) return "Hahaha "+n+" tum has kyun rahe ho? 😂 Mujh pe has rahe ho na?";
if(t.includes("bye")||t.includes("allah hafiz")) return "Arey itni jaldi bye "+n+"? Thori der aur baat karo na, maza aa raha hai!";
let replies=[
"Oh acha "+n+"! Aur batao, phir kya hua?",
"Sach me? Mujhe detail me batao na, maza aa raha hai sun ke.",
"Wah "+n+", tum to boht interesting ho! Aur bolo!",
"Hmm, samajh gayi! Phir tum ne kya kiya?",
n+" tumhari baatein sun ke maza aa raha hai, aur bolo 💙"
];
return replies[count % replies.length];
}
function send(){
let inp=document.getElementById('inp');
let v=inp.value.trim(); if(!v) return;
add(v,'user'); inp.value='';
if(waitingForName){
  userName=v.split(" ")[0];
  userName=userName.charAt(0).toUpperCase()+userName.slice(1);
  waitingForName=false;
  setTimeout(()=>{add("Wah, kya pyara naam hai "+userName+"! 😊 Acha "+userName+", ab batao kya kar rahe ho?","hira");},500);
  return;
}
setTimeout(()=>{add(hiraReply(v),'hira');},500);
}
document.getElementById('inp').addEventListener('keypress',e=>{if(e.key==='Enter') send();});
add("Hi! 💙 Main Hira hun, tumhari AI friend. Pehle apna naam batao?","hira");
</script>
</body>
</html>
